{
  "openapi": "3.1.0",
  "info": {
    "title": "PipSync API",
    "version": "1.0.0",
    "description": "Public REST API for PipSync — trading-signal automation platform. Available on the Enterprise plan.",
    "contact": {
      "name": "PipSync Support",
      "email": "support@pipsync.io",
      "url": "https://pipsync.io/support"
    },
    "license": {
      "name": "Proprietary"
    }
  },
  "servers": [
    {
      "url": "https://app.pipsync.io/api/v1",
      "description": "Production"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API-Key",
        "description": "PipSync API key with format `pipsync_live_<32 alnum>`. Obtain one at https://app.pipsync.io/settings/api-keys (Enterprise tier only)."
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing or invalid API key",
        "content": {
          "application/problem+json": {
            "schema": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "format": "uri"
                },
                "title": {
                  "type": "string"
                },
                "status": {
                  "type": "integer"
                },
                "detail": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Forbidden": {
        "description": "API key lacks the required permission scope",
        "content": {
          "application/problem+json": {
            "schema": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "format": "uri"
                },
                "title": {
                  "type": "string"
                },
                "status": {
                  "type": "integer"
                },
                "detail": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "RateLimited": {
        "description": "Rate-limit exceeded — see Retry-After header",
        "content": {
          "application/problem+json": {
            "schema": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "format": "uri"
                },
                "title": {
                  "type": "string"
                },
                "status": {
                  "type": "integer"
                },
                "detail": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "Signal": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "instrument": {
            "type": "string",
            "example": "EURUSD"
          },
          "direction": {
            "type": "string",
            "enum": [
              "BUY",
              "SELL"
            ]
          },
          "entryPrice": {
            "type": "string",
            "example": "1.0850"
          },
          "stopLoss": {
            "type": [
              "string",
              "null"
            ],
            "example": "1.0820"
          },
          "takeProfits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "channelName": {
            "type": "string"
          },
          "providerName": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "receivedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "Trade": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "instrument": {
            "type": "string"
          },
          "direction": {
            "type": "string"
          },
          "entryPrice": {
            "type": "string"
          },
          "stopLoss": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "signalId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "openedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "TradeReportRow": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "instrument": {
            "type": "string",
            "example": "EURUSD"
          },
          "direction": {
            "type": "string",
            "example": "BUY"
          },
          "entryPrice": {
            "type": "string",
            "example": "1.08500"
          },
          "lotSize": {
            "type": "string",
            "example": "0.10"
          },
          "stopLoss": {
            "type": "string",
            "example": "1.08200"
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "realizedPnl": {
            "type": [
              "string",
              "null"
            ],
            "example": "24.50"
          },
          "unrealizedPnl": {
            "type": [
              "string",
              "null"
            ],
            "example": "-3.20"
          },
          "openedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "closedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "signalId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        }
      },
      "TradeReportMeta": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "realizedPnl": {
            "type": "number"
          },
          "unrealizedPnl": {
            "type": "number"
          },
          "closedTrades": {
            "type": "integer"
          },
          "winRate": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      },
      "ReportCatalogEntry": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "trades"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "available",
              "planned"
            ]
          },
          "permission": {
            "type": "string",
            "example": "read:trades"
          },
          "href": {
            "type": [
              "string",
              "null"
            ],
            "example": "/api/v1/reports/trades"
          },
          "formats": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "json",
                "csv",
                "pdf"
              ]
            }
          },
          "filters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ReportScheduleEntry": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "reportType": {
            "type": "string",
            "example": "trades"
          },
          "frequency": {
            "type": "string",
            "enum": [
              "daily",
              "weekly",
              "monthly"
            ]
          },
          "format": {
            "type": "string",
            "enum": [
              "json",
              "csv",
              "pdf"
            ]
          },
          "targetEmail": {
            "type": "string",
            "format": "email"
          },
          "timezone": {
            "type": "string",
            "example": "UTC"
          },
          "filters": {
            "type": "object"
          },
          "nextRunAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastRunAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "AccountUsageLimit": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "max": {
            "type": [
              "integer",
              "null"
            ]
          },
          "used": {
            "type": "integer"
          },
          "period": {
            "type": "string",
            "enum": [
              "forever",
              "monthly",
              "daily"
            ]
          }
        }
      },
      "AccountUsage": {
        "type": "object",
        "properties": {
          "tier": {
            "type": "string",
            "enum": [
              "free",
              "starter",
              "basic",
              "pro",
              "advanced",
              "enterprise"
            ]
          },
          "status": {
            "type": "string"
          },
          "periodEnd": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "limits": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountUsageLimit"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Service health probe",
        "security": [],
        "responses": {
          "200": {
            "description": "API is up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "version": {
                      "type": "string",
                      "example": "v1"
                    },
                    "time": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/me": {
      "get": {
        "summary": "Authenticated user profile + tier",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "type": "object"
                    },
                    "subscription": {
                      "type": "object"
                    },
                    "apiKey": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/signals": {
      "get": {
        "summary": "List recent signals",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "since",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Signal"
                      }
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "count": {
                          "type": "integer"
                        },
                        "limit": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/trades": {
      "get": {
        "summary": "List recent trades",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "open",
                "closed",
                "cancelled"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Trade"
                      }
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "count": {
                          "type": "integer"
                        },
                        "limit": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/reports": {
      "get": {
        "summary": "List available report exports",
        "description": "Returns the public report catalog for JSON, CSV and PDF exports.",
        "responses": {
          "200": {
            "description": "Report catalog",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "format": {
                      "type": "string",
                      "example": "pipsync.reports.catalog.v1"
                    },
                    "generatedAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ReportCatalogEntry"
                      }
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "count": {
                          "type": "integer"
                        },
                        "available": {
                          "type": "integer"
                        },
                        "planned": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/reports/trades": {
      "get": {
        "summary": "Export a trade performance report",
        "description": "Returns a DB-backed trade report for the authenticated API key. Use `format=csv` for spreadsheet export or `format=pdf` for a printable report.",
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "csv",
                "pdf"
              ],
              "default": "json"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 500
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "open",
                "closed",
                "partial",
                "rejected",
                "all"
              ]
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Trade report",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "format": {
                      "type": "string",
                      "example": "pipsync.reports.trades.v1"
                    },
                    "exportedAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "range": {
                      "type": "object",
                      "properties": {
                        "from": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "format": "date-time"
                        },
                        "to": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "format": "date-time"
                        }
                      }
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/TradeReportRow"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/TradeReportMeta"
                    }
                  }
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameter",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "format": "uri"
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    },
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/reports/schedules": {
      "get": {
        "summary": "List scheduled report deliveries",
        "description": "Returns scheduled trade report email deliveries for the authenticated API key owner.",
        "responses": {
          "200": {
            "description": "Report schedules",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "format": {
                      "type": "string",
                      "example": "pipsync.reports.schedules.v1"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ReportScheduleEntry"
                      }
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "count": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      },
      "post": {
        "summary": "Create a scheduled report delivery",
        "description": "Creates a daily, weekly or monthly trade report delivery with JSON, CSV or branded PDF attachment.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "frequency",
                  "targetEmail"
                ],
                "properties": {
                  "frequency": {
                    "type": "string",
                    "enum": [
                      "daily",
                      "weekly",
                      "monthly"
                    ]
                  },
                  "format": {
                    "type": "string",
                    "enum": [
                      "json",
                      "csv",
                      "pdf"
                    ],
                    "default": "pdf"
                  },
                  "targetEmail": {
                    "type": "string",
                    "format": "email"
                  },
                  "timezone": {
                    "type": "string",
                    "default": "UTC"
                  },
                  "filters": {
                    "type": "object"
                  },
                  "nextRunAt": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Report schedule created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "format": {
                      "type": "string",
                      "example": "pipsync.reports.schedule.created.v1"
                    },
                    "data": {
                      "$ref": "#/components/schemas/ReportScheduleEntry"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid payload",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "format": "uri"
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    },
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/account/usage": {
      "get": {
        "summary": "Current tier + usage counters + limits",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountUsage"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    }
  }
}
